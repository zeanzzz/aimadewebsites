<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aetheris - Rendered Biomes with Ground Terrain</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body, html {
      width: 100%; height: 100%; overflow-x: hidden;
      background-color: #050b14; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #e2e8f0;
    }
    #webgl-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; }
    #scroll-height { height: 1300vh; position: relative; z-index: 2; }

    /* UI Overlay Cards */
    .zone-overlay {
      position: fixed; top: 50%; left: 6%; transform: translateY(-50%);
      z-index: 10; max-width: 460px; pointer-events: none; opacity: 0;
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .zone-overlay.active { opacity: 1; transform: translateY(-50%) translateX(0); }
    
    .zone-card-wrapper {
      background: rgba(10, 18, 32, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-left: 4px solid var(--theme-color, #00b4d8);
      padding: 28px; border-radius: 16px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 40px var(--glow-color, rgba(0, 180, 216, 0.2));
      backdrop-filter: blur(20px); color: #f8fafc;
    }

    .zone-tag {
      display: inline-block; font-size: 0.7rem; font-weight: 800; letter-spacing: 2.5px; text-transform: uppercase;
      color: #ffffff; background: var(--theme-color, #00b4d8); border: none;
      padding: 6px 14px; border-radius: 20px; margin-bottom: 16px;
      box-shadow: 0 0 15px var(--glow-color, rgba(0, 180, 216, 0.5));
    }
    .zone-title {
      font-size: 2.2rem; font-weight: 900; line-height: 1.1; text-transform: uppercase;
      letter-spacing: -0.5px; color: #ffffff; margin-bottom: 14px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .zone-desc { font-size: 0.9rem; line-height: 1.6; color: #94a3b8; }

    /* HUD Alert */
    .tunnel-alert {
      position: fixed; bottom: 8%; left: 50%; transform: translateX(-50%);
      z-index: 10; pointer-events: none; opacity: 0; transition: opacity 0.5s ease;
      background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(56, 189, 248, 0.4);
      padding: 12px 28px; border-radius: 30px; backdrop-filter: blur(12px);
      color: #38bdf8; font-size: 0.75rem; letter-spacing: 4px; font-weight: 800; text-transform: uppercase;
      box-shadow: 0 0 25px rgba(56, 189, 248, 0.3);
    }
    .tunnel-alert.active { opacity: 1; }

    /* Loader */
    #loader {
      position: fixed; inset: 0; background: #050b14; z-index: 100;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      transition: opacity 0.8s ease;
    }
    .spinner {
      width: 60px; height: 60px; border: 3px solid rgba(56, 189, 248, 0.1);
      border-top-color: #38bdf8; border-right-color: #f43f5e; border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-text { margin-top: 24px; font-size: 0.75rem; font-weight: 800; letter-spacing: 4px; color: #38bdf8; text-transform: uppercase; }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
</head>
<body>

  <div id="loader">
    <div class="spinner"></div>
    <div class="loading-text">Constructing Ground Networks & Craft...</div>
  </div>

  <div id="webgl-container"></div>
  <div class="tunnel-alert" id="tunnel-hud">/// TRANSITION TUNNEL // TRAVERSING BIOMES ///</div>

  <!-- LOCATION 1 -->
  <div class="zone-overlay" id="zone-1" style="--theme-color: #38bdf8; --glow-color: rgba(56,189,248,0.4);">
    <div class="zone-card-wrapper">
      <div class="zone-tag">Location 01 // Glacial Citadel</div>
      <h1 class="zone-title">Frost Crystal Citadel</h1>
      <p class="zone-desc"><strong style="color:#f8fafc">Biome:</strong> Glacial Ice & Sky Spires<br><strong style="color:#f8fafc">Ground Infrastructure:</strong> Crystalline plaza, radiant transit lanes, and blue luminescent street poles.</p>
    </div>
  </div>

  <!-- LOCATION 2 -->
  <div class="zone-overlay" id="zone-2" style="--theme-color: #f59e0b; --glow-color: rgba(245,158,11,0.4);">
    <div class="zone-card-wrapper">
      <div class="zone-tag">Location 02 // Solar Desert</div>
      <h1 class="zone-title">Golden Sol Pyramids</h1>
      <p class="zone-desc"><strong style="color:#f8fafc">Biome:</strong> Arid Dunes & Brass Steampunk<br><strong style="color:#f8fafc">Ground Infrastructure:</strong> Sun-baked stone flagstones, amber energy conduits, and solar beacon lamps.</p>
    </div>
  </div>

  <!-- LOCATION 3 -->
  <div class="zone-overlay" id="zone-3" style="--theme-color: #f43f5e; --glow-color: rgba(244,63,94,0.4);">
    <div class="zone-card-wrapper">
      <div class="zone-tag">Location 03 // Sky Metropolis</div>
      <h1 class="zone-title">Neo-Tokyo Arcade</h1>
      <p class="zone-desc"><strong style="color:#f8fafc">Biome:</strong> Cyberpunk Canyon<br><strong style="color:#f8fafc">Ground Infrastructure:</strong> Dark asphalt highways, neon road markings, and magenta light posts.</p>
    </div>
  </div>

  <div id="scroll-height"></div>

  <script>
    gsap.registerPlugin(ScrollTrigger);

    // --- PROCEDURAL FAÇADE TEXTURES ---
    function generateAdvancedTexture(type) {
      const canvas = document.createElement('canvas');
      canvas.width = 512; canvas.height = 1024;
      const ctx = canvas.getContext('2d');

      if (type === 'ice') {
        let grad = ctx.createLinearGradient(0, 0, 0, 1024);
        grad.addColorStop(0, '#0f172a'); grad.addColorStop(1, '#0284c7');
        ctx.fillStyle = grad; ctx.fillRect(0, 0, 512, 1024);
        ctx.fillStyle = '#e0f2fe';
        for (let y = 20; y < 1000; y += 40) {
          for (let x = 15; x < 490; x += 30) {
            if (Math.random() > 0.3) ctx.fillRect(x, y, 12, 24);
          }
        }
      } else if (type === 'desert') {
        let grad = ctx.createLinearGradient(0, 0, 512, 1024);
        grad.addColorStop(0, '#451a03'); grad.addColorStop(1, '#b45309');
        ctx.fillStyle = grad; ctx.fillRect(0, 0, 512, 1024);
        ctx.fillStyle = '#fef08a';
        for (let y = 0; y < 1024; y += 64) {
          ctx.fillRect(0, y, 512, 4);
          for (let x = 20; x < 490; x += 45) {
            if (Math.random() > 0.4) ctx.fillRect(x, y + 10, 25, 35);
          }
        }
      } else if (type === 'cyber') {
        ctx.fillStyle = '#09090b'; ctx.fillRect(0, 0, 512, 1024);
        for (let y = 30; y < 1000; y += 50) {
          for (let x = 20; x < 490; x += 35) {
            if (Math.random() > 0.2) {
              ctx.fillStyle = Math.random() > 0.5 ? '#f43f5e' : '#38bdf8';
              ctx.fillRect(x, y, 18, 32);
            }
          }
        }
      }

      const tex = new THREE.CanvasTexture(canvas);
      tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
      return tex;
    }

    // --- PROCEDURAL GROUND & ROAD TEXTURES ---
    function generateGroundTexture(type) {
      const canvas = document.createElement('canvas');
      canvas.width = 1024; canvas.height = 1024;
      const ctx = canvas.getContext('2d');

      if (type === 'ice') {
        ctx.fillStyle = '#0369a1'; ctx.fillRect(0, 0, 1024, 1024);
        ctx.strokeStyle = '#0284c7'; ctx.lineWidth = 8;
        for (let i = 0; i <= 1024; i += 128) {
          ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 1024); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(1024, i); ctx.stroke();
        }
        // Radiant lanes
        ctx.fillStyle = '#38bdf8';
        ctx.fillRect(492, 0, 40, 1024); ctx.fillRect(0, 492, 1024, 40);
      } else if (type === 'desert') {
        ctx.fillStyle = '#78350f'; ctx.fillRect(0, 0, 1024, 1024);
        ctx.strokeStyle = '#92400e'; ctx.lineWidth = 12;
        for (let i = 0; i <= 1024; i += 256) {
          ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 1024); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(1024, i); ctx.stroke();
        }
        // Energy conduits
        ctx.fillStyle = '#f59e0b';
        ctx.fillRect(502, 0, 20, 1024); ctx.fillRect(0, 502, 1024, 20);
      } else if (type === 'cyber') {
        ctx.fillStyle = '#18181b'; ctx.fillRect(0, 0, 1024, 1024);
        // Main Asphalt Road Network
        ctx.fillStyle = '#09090b';
        ctx.fillRect(432, 0, 160, 1024); ctx.fillRect(0, 432, 1024, 160);
        // Neon Lanes
        ctx.strokeStyle = '#f43f5e'; ctx.lineWidth = 6;
        ctx.beginPath(); ctx.moveTo(512, 0); ctx.lineTo(512, 1024); ctx.stroke();
        ctx.strokeStyle = '#38bdf8';
        ctx.beginPath(); ctx.moveTo(0, 512); ctx.lineTo(1024, 512); ctx.stroke();
      }

      const tex = new THREE.CanvasTexture(canvas);
      tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(4, 4);
      return tex;
    }

    const texIce = generateAdvancedTexture('ice'); texIce.repeat.set(1, 4);
    const texDesert = generateAdvancedTexture('desert'); texDesert.repeat.set(1, 4);
    const texCyber = generateAdvancedTexture('cyber'); texCyber.repeat.set(1, 4);

    const groundTexIce = generateGroundTexture('ice');
    const groundTexDesert = generateGroundTexture('desert');
    const groundTexCyber = generateGroundTexture('cyber');

    // --- SCENE SETUP ---
    const container = document.getElementById('webgl-container');
    const scene = new THREE.Scene();
    const bgColor = new THREE.Color(0x050b14);
    scene.background = bgColor;
    scene.fog = new THREE.FogExp2(0x050b14, 0.0018);

    const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 3000);
    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    container.appendChild(renderer.domElement);

    // Post-Processing
    const composer = new THREE.EffectComposer(renderer);
    composer.addPass(new THREE.RenderPass(scene, camera));
    const bloomPass = new THREE.UnrealBloomPass(
      new THREE.Vector2(window.innerWidth, window.innerHeight),
      0.8, 0.3, 0.85
    );
    composer.addPass(bloomPass);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x0f172a, 0.9);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.0);
    keyLight.position.set(150, 400, 200);
    keyLight.castShadow = true;
    keyLight.shadow.mapSize.width = 2048; keyLight.shadow.mapSize.height = 2048;
    scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0x38bdf8, 2.5);
    rimLight.position.set(-200, 100, -200);
    scene.add(rimLight);

    // --- HELPER: STREET LIGHTS GENERATOR ---
    function addStreetLights(group, radius, count, lightColor, heightOffset) {
      const poleGeo = new THREE.CylinderGeometry(0.4, 0.6, 18, 8);
      const poleMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.8, roughness: 0.2 });
      const lampGeo = new THREE.SphereGeometry(1.5, 16, 16);
      const lampMat = new THREE.MeshBasicMaterial({ color: lightColor });

      for (let i = 0; i < count; i++) {
        const angle = (i / count) * Math.PI * 2;
        const x = Math.cos(angle) * radius;
        const z = Math.sin(angle) * radius;

        const pole = new THREE.Mesh(poleGeo, poleMat);
        pole.position.set(x, heightOffset + 9, z);
        pole.castShadow = true;

        const lamp = new THREE.Mesh(lampGeo, lampMat);
        lamp.position.set(x, heightOffset + 18, z);

        const pointLight = new THREE.PointLight(lightColor, 1.2, 45);
        pointLight.position.copy(lamp.position);

        group.add(pole, lamp, pointLight);
      }
    }

    // =========================================================================
    // LOCATION 01: FROST CRYSTAL CITADEL
    // =========================================================================
    const loc1Group = new THREE.Group();
    loc1Group.position.set(0, 350, 0);

    // Ice Ground Plaza
    const groundGeo1 = new THREE.PlaneGeometry(800, 800);
    const groundMat1 = new THREE.MeshStandardMaterial({ 
      map: groundTexIce, roughness: 0.1, metalness: 0.3, color: 0x0284c7 
    });
    const ground1 = new THREE.Mesh(groundGeo1, groundMat1);
    ground1.rotation.x = -Math.PI / 2;
    ground1.position.y = -100;
    ground1.receiveShadow = true;
    loc1Group.add(ground1);

    // Spire Landmark
    const prismGeo = new THREE.ConeGeometry(35, 240, 6);
    const prismMat = new THREE.MeshPhysicalMaterial({ 
      color: 0x38bdf8, transmission: 0.6, opacity: 1, transparent: true,
      roughness: 0.05, metalness: 0.1, ior: 1.5, emissive: 0x0284c7, emissiveIntensity: 0.8 
    });
    const prismSpire = new THREE.Mesh(prismGeo, prismMat);
    prismSpire.position.set(0, 20, -120);
    prismSpire.castShadow = true;
    loc1Group.add(prismSpire);

    const crystalRing = new THREE.Mesh(new THREE.TorusGeometry(55, 1.5, 16, 60), new THREE.MeshBasicMaterial({ color: 0x38bdf8 }));
    crystalRing.position.set(0, 60, -120);
    crystalRing.rotation.x = Math.PI / 3;
    loc1Group.add(crystalRing);

    for (let i = 0; i < 35; i++) {
      const angle = (i / 35) * Math.PI * 2;
      const radius = 130 + Math.random() * 90;
      const h = 90 + Math.random() * 120;
      
      const bGeo = new THREE.ConeGeometry(25, h, 5);
      const bMat = new THREE.MeshStandardMaterial({ map: texIce, roughness: 0.2, metalness: 0.5 });
      const building = new THREE.Mesh(bGeo, bMat);
      building.position.set(Math.cos(angle)*radius, (h/2)-100, Math.sin(angle)*radius);
      building.castShadow = true; building.receiveShadow = true;
      loc1Group.add(building);
    }

    addStreetLights(loc1Group, 110, 12, 0x38bdf8, -100);
    scene.add(loc1Group);

    // =========================================================================
    // TRANSITION TUNNEL 1
    // =========================================================================
    function createTunnel(startY, endY, radius, accentColor) {
      const group = new THREE.Group();
      const height = Math.abs(startY - endY);
      const centerY = (startY + endY) / 2;

      const tube = new THREE.Mesh(
        new THREE.CylinderGeometry(radius, radius, height, 32, 1, true),
        new THREE.MeshStandardMaterial({ color: 0x090d16, side: THREE.BackSide, roughness: 0.7 })
      );
      tube.position.y = centerY;
      group.add(tube);

      for (let i = 0; i < 28; i++) {
        const ry = startY - (i / 28) * height;
        const rib = new THREE.Mesh(new THREE.TorusGeometry(radius - 0.8, 1.2, 12, 32), 
          new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.8, roughness: 0.2 }));
        rib.position.y = ry; rib.rotation.x = Math.PI / 2;
        group.add(rib);

        if (i % 2 === 0) {
          const neon = new THREE.Mesh(new THREE.TorusGeometry(radius - 0.4, 0.4, 8, 32), 
            new THREE.MeshBasicMaterial({ color: accentColor }));
          neon.position.y = ry - (height / 28)/2; neon.rotation.x = Math.PI / 2;
          group.add(neon);
        }
      }
      return group;
    }

    scene.add(createTunnel(200, -50, 48, 0x38bdf8));

    // =========================================================================
    // LOCATION 02: GOLDEN SOL PYRAMIDS
    // =========================================================================
    const loc2Group = new THREE.Group();
    loc2Group.position.set(0, -200, 0);

    // Desert Sand / Flagstone Ground
    const ground2 = new THREE.Mesh(new THREE.PlaneGeometry(800, 800), 
      new THREE.MeshStandardMaterial({ map: groundTexDesert, roughness: 0.8, color: 0xd97706 }));
    ground2.rotation.x = -Math.PI / 2;
    ground2.position.y = -80;
    ground2.receiveShadow = true;
    loc2Group.add(ground2);

    const pyrGeo = new THREE.CylinderGeometry(0, 70, 110, 4);
    const pyrMat = new THREE.MeshStandardMaterial({ map: texDesert, roughness: 0.4, metalness: 0.6, color: 0xf59e0b });
    const mainPyramid = new THREE.Mesh(pyrGeo, pyrMat);
    mainPyramid.position.set(0, -25, -140);
    mainPyramid.rotation.y = Math.PI / 4;
    mainPyramid.castShadow = true; mainPyramid.receiveShadow = true;
    loc2Group.add(mainPyramid);

    const solSphere = new THREE.Mesh(new THREE.SphereGeometry(14, 32, 32), new THREE.MeshBasicMaterial({ color: 0xfef08a }));
    solSphere.position.set(0, 45, -140);
    loc2Group.add(solSphere);

    for (let i = 0; i < 30; i++) {
      const angle = (i / 30) * Math.PI * 2;
      const radius = 140 + Math.random() * 80;
      const h = 60 + Math.random() * 80;

      const b = new THREE.Mesh(new THREE.BoxGeometry(35, h, 35), 
        new THREE.MeshStandardMaterial({ map: texDesert, roughness: 0.5 }));
      b.position.set(Math.cos(angle)*radius, (h/2)-80, Math.sin(angle)*radius);
      b.castShadow = true; b.receiveShadow = true;
      loc2Group.add(b);
    }

    addStreetLights(loc2Group, 120, 10, 0xf59e0b, -80);
    scene.add(loc2Group);
    scene.add(createTunnel(-350, -600, 48, 0xf59e0b));

    // =========================================================================
    // LOCATION 03: NEO-TOKYO SKY-ARCADE
    // =========================================================================
    const loc3Group = new THREE.Group();
    loc3Group.position.set(0, -750, 0);

    // City Highway Ground
    const ground3 = new THREE.Mesh(new THREE.PlaneGeometry(800, 800), 
      new THREE.MeshStandardMaterial({ map: groundTexCyber, roughness: 0.3, metalness: 0.6 }));
    ground3.rotation.x = -Math.PI / 2;
    ground3.position.y = -90;
    ground3.receiveShadow = true;
    loc3Group.add(ground3);

    const toriiGroup = new THREE.Group();
    toriiGroup.position.set(0, -20, -110);

    const pillarMat = new THREE.MeshStandardMaterial({ color: 0x881337, roughness: 0.3, metalness: 0.2 });
    const neonRedMat = new THREE.MeshBasicMaterial({ color: 0xf43f5e });

    const p1 = new THREE.Mesh(new THREE.BoxGeometry(12, 140, 12), pillarMat); p1.position.set(-50, 0, 0);
    const p2 = new THREE.Mesh(new THREE.BoxGeometry(12, 140, 12), pillarMat); p2.position.set(50, 0, 0);
    const topBeam = new THREE.Mesh(new THREE.BoxGeometry(140, 16, 16), pillarMat); topBeam.position.set(0, 65, 0);
    const neonBeam = new THREE.Mesh(new THREE.BoxGeometry(144, 4, 18), neonRedMat); neonBeam.position.set(0, 75, 0);

    p1.castShadow = true; p2.castShadow = true; topBeam.castShadow = true;
    toriiGroup.add(p1, p2, topBeam, neonBeam);
    loc3Group.add(toriiGroup);

    for (let i = 0; i < 35; i++) {
      const angle = (i / 35) * Math.PI * 2;
      const radius = 130 + Math.random() * 90;
      const h = 120 + Math.random() * 140;

      const b = new THREE.Mesh(new THREE.BoxGeometry(30, h, 30), 
        new THREE.MeshStandardMaterial({ map: texCyber, roughness: 0.2, metalness: 0.7 }));
      b.position.set(Math.cos(angle)*radius, (h/2)-90, Math.sin(angle)*radius);
      b.castShadow = true; b.receiveShadow = true;
      loc3Group.add(b);
    }

    addStreetLights(loc3Group, 105, 14, 0xf43f5e, -90);
    scene.add(loc3Group);

    // =========================================================================
    // HIGH-DETAIL SPACECRAFT DESIGN
    // =========================================================================
    const shipGroup = new THREE.Group();

    const hullMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, roughness: 0.15, metalness: 0.85 });
    const darkMetalMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.3, metalness: 0.9 });
    const glassMat = new THREE.MeshPhysicalMaterial({ color: 0x38bdf8, transmission: 0.9, opacity: 1, transparent: true, roughness: 0.05, ior: 1.5 });
    const engineGlowMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });

    // Main Fuselage
    const mainBody = new THREE.Mesh(new THREE.ConeGeometry(2.2, 12, 8), hullMat);
    mainBody.rotation.x = Math.PI / 2;
    mainBody.castShadow = true;
    shipGroup.add(mainBody);

    // Glass Canopy Cockpit
    const canopy = new THREE.Mesh(new THREE.SphereGeometry(1.4, 16, 16, 0, Math.PI * 2, 0, Math.PI / 2), glassMat);
    canopy.rotation.x = -Math.PI / 3;
    canopy.position.set(0, 0.8, -1.5);
    canopy.scale.set(1, 0.7, 2);
    shipGroup.add(canopy);

    // Swept-back Main Wings
    const wingShape = new THREE.Shape();
    wingShape.moveTo(0, 0);
    wingShape.lineTo(7, -4);
    wingShape.lineTo(7, -6);
    wingShape.lineTo(0, -2);
    const extrudeSettings = { depth: 0.3, bevelEnabled: true, bevelSegments: 2, steps: 1, bevelSize: 0.1, bevelThickness: 0.1 };
    const wingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);
    
    const rightWing = new THREE.Mesh(wingGeo, hullMat);
    rightWing.rotation.x = Math.PI / 2; rightWing.position.set(0.5, 0, 1);
    rightWing.castShadow = true;
    
    const leftWing = new THREE.Mesh(wingGeo, hullMat);
    leftWing.rotation.x = Math.PI / 2; leftWing.scale.set(-1, 1, 1); leftWing.position.set(-0.5, 0, 1);
    leftWing.castShadow = true;

    shipGroup.add(rightWing, leftWing);

    // Wingtip Plasma Cannons
    const cannonGeo = new THREE.CylinderGeometry(0.2, 0.2, 4, 12);
    const cannonRight = new THREE.Mesh(cannonGeo, darkMetalMat);
    cannonRight.rotation.x = Math.PI / 2; cannonRight.position.set(7.2, 0, -1);
    const cannonLeft = new THREE.Mesh(cannonGeo, darkMetalMat);
    cannonLeft.rotation.x = Math.PI / 2; cannonLeft.position.set(-7.2, 0, -1);
    shipGroup.add(cannonRight, cannonLeft);

    // Dual Engine Nacelles with Glowing Thrusters
    const nacelleGeo = new THREE.CylinderGeometry(0.9, 1.1, 5, 16);
    const nacelleR = new THREE.Mesh(nacelleGeo, darkMetalMat);
    nacelleR.rotation.x = Math.PI / 2; nacelleR.position.set(2, 0.2, 3);
    const nacelleL = new THREE.Mesh(nacelleGeo, darkMetalMat);
    nacelleL.rotation.x = Math.PI / 2; nacelleL.position.set(-2, 0.2, 3);

    const thrusterGlowGeo = new THREE.ConeGeometry(0.8, 3.5, 16);
    const thrusterR = new THREE.Mesh(thrusterGlowGeo, engineGlowMat);
    thrusterR.rotation.x = -Math.PI / 2; thrusterR.position.set(2, 0.2, 6.2);
    const thrusterL = new THREE.Mesh(thrusterGlowGeo, engineGlowMat);
    thrusterL.rotation.x = -Math.PI / 2; thrusterL.position.set(-2, 0.2, 6.2);

    shipGroup.add(nacelleR, nacelleL, thrusterR, thrusterL);
    scene.add(shipGroup);

    // =========================================================================
    // FLIGHT PATH & ANIMATION LOOP
    // =========================================================================
    const flightPath = new THREE.CatmullRomCurve3([
      new THREE.Vector3(0, 460, 60),
      new THREE.Vector3(25, 360, -20),
      new THREE.Vector3(-20, 270, 30),
      new THREE.Vector3(0, 180, 0),
      new THREE.Vector3(0, 70, 0),
      new THREE.Vector3(0, -30, 0),
      new THREE.Vector3(-30, -110, 40),
      new THREE.Vector3(35, -200, -20),
      new THREE.Vector3(-20, -280, 30),
      new THREE.Vector3(0, -370, 0),
      new THREE.Vector3(0, -475, 0),
      new THREE.Vector3(0, -580, 0),
      new THREE.Vector3(30, -660, -30),
      new THREE.Vector3(-25, -750, 30),
      new THREE.Vector3(0, -830, -20)
    ]);

    const scrollObj = { progress: 0 };
    gsap.to(scrollObj, {
      progress: 1, ease: "none",
      scrollTrigger: { trigger: "#scroll-height", start: "top top", end: "bottom bottom", scrub: 1.2 }
    });

    const zones = [
      { id: '#zone-1', start: 0.02, end: 0.22, fogColor: 0x050b14, rimColor: 0x38bdf8 },
      { id: '#zone-2', start: 0.36, end: 0.54, fogColor: 0x1a0c03, rimColor: 0xf59e0b },
      { id: '#zone-3', start: 0.72, end: 0.95, fogColor: 0x18040a, rimColor: 0xf43f5e }
    ];

    zones.forEach(z => {
      ScrollTrigger.create({
        trigger: "#scroll-height", start: `${z.start * 100}% top`, end: `${z.end * 100}% top`,
        onEnter: () => updateBiomeVisuals(z),
        onEnterBack: () => updateBiomeVisuals(z),
        onLeave: () => document.querySelector(z.id).classList.remove('active'),
        onLeaveBack: () => document.querySelector(z.id).classList.remove('active')
      });
    });

    function updateBiomeVisuals(z) {
      document.querySelector(z.id).classList.add('active');
      const targetColor = new THREE.Color(z.fogColor);
      gsap.to(scene.fog.color, { r: targetColor.r, g: targetColor.g, b: targetColor.b, duration: 1.2 });
      gsap.to(scene.background, { r: targetColor.r, g: targetColor.g, b: targetColor.b, duration: 1.2 });
      gsap.to(rimLight.color, { ...new THREE.Color(z.rimColor), duration: 1.2 });
      
      // Sync engine glow color with current biome
      const glowColor = z.rimColor;
      thrusterR.material.color.setHex(glowColor);
      thrusterL.material.color.setHex(glowColor);
    }

    const tunnelHUD = document.getElementById('tunnel-hud');
    const tunnelRanges = [{ start: 0.23, end: 0.35 }, { start: 0.55, end: 0.71 }];

    ScrollTrigger.create({
      trigger: "#scroll-height", start: "top top", end: "bottom bottom",
      onUpdate: (self) => {
        const p = self.progress;
        const inTunnel = tunnelRanges.some(r => p >= r.start && p <= r.end);
        if (inTunnel) tunnelHUD.classList.add('active');
        else tunnelHUD.classList.remove('active');
      }
    });

    window.addEventListener('load', () => {
      const loader = document.getElementById('loader');
      loader.style.opacity = '0';
      setTimeout(() => loader.style.display = 'none', 800);
    });

    // --- RENDER LOOP ---
    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();
      const t = scrollObj.progress;

      const currentPoint = flightPath.getPointAt(t);
      const lookAtPoint = flightPath.getPointAt(Math.min(t + 0.012, 1.0));
      camera.position.copy(currentPoint);
      camera.lookAt(lookAtPoint);

      const shipTargetPos = currentPoint.clone().add(
        lookAtPoint.clone().sub(currentPoint).normalize().multiplyScalar(20)
      );

      const hoverY = Math.sin(elapsedTime * 4) * 0.3;
      shipGroup.position.set(shipTargetPos.x, shipTargetPos.y + hoverY, shipTargetPos.z);
      shipGroup.lookAt(lookAtPoint.clone().add(new THREE.Vector3(0, hoverY, 0)));

      const tangent = flightPath.getTangentAt(t);
      shipGroup.rotation.z = THREE.MathUtils.lerp(shipGroup.rotation.z, -tangent.x * 2.5, 0.1);

      crystalRing.rotation.z = elapsedTime * 0.5;
      mainPyramid.rotation.y = elapsedTime * 0.15;

      composer.render();
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      composer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
